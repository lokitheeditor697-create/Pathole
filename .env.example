# ==============================================================================
# 1. PLATFORM & DEPLOYMENT CONFIGURATION
# ==============================================================================
PORT=3000
NODE_ENV=development

# Dual-Host Deployment:
# Frontend (Vercel / HF Static): Set VITE_API_BASE_URL to your deployed backend URL:
# VITE_API_BASE_URL=https://road-pothole-backend.onrender.com
# In local development, leave empty to proxy through local server.
VITE_API_BASE_URL=

# Backend Public Base URL (Used for external WhatsApp/Telegram snapshot images & links):
# e.g., https://road-pothole-backend.onrender.com (or http://localhost:3000 locally)
BASE_URL=

VITE_GOOGLE_MAPS_API_KEY=

# Database Connection (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/road_intelligence_db

# Security & Admin Key (Required for /api/db/reset and alert config updates)
ADMIN_SECRET_KEY=gcc2026

# ==============================================================================
# 2. TELEGRAM BOT ALERTS (Instant Push Notifications)
# ==============================================================================
# Recipient channel or handle description (e.g. @BotFather Bot Hook)
TELEGRAM_TARGET=@BotFather Bot Hook

# Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=987654321

# ==============================================================================
# 3. GMAIL / SMTP EMAIL TICKETS (Formal Dispatch Emails)
# ==============================================================================
# Sender Gmail address
GMAIL_USER=pwd.chennaicorp@gmail.com

# 16-character Google App Password (Google Account -> Security -> App Passwords)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Recipient official emails (comma-separated)
ALERT_RECIPIENTS=roadmaintenance@chennaicorp.gov.in,wardofficer@chennai.gov.in

# ==============================================================================
# 3. ALERT DISPATCH & TRIGGER CRITERIA
# ==============================================================================
# Defines the exact operational rule for when to dispatch instant alerts (Telegram / Email / SMS) to municipal officials:
# Supported Options:
# MULTI_BUS_VERIFIED (Recommended) - Fires alerts only when >= 2 distinct buses confirm the same pothole within 15 meters & 10 minutes. Eliminates 100% of single-camera false alarms.
# HIGH_SEVERITY - Fires alerts on any High severity pothole immediately (even on first single-bus detection), plus all multi-bus confirmations.
# ALL_VERIFIED - Fires alerts for every detected road defect (High, Medium, and Low severity).
# CRITICAL_ONLY - Fires alerts only when all 4 route buses confirm (bus_count >= 4) or emergency critical defects.
ALERT_TRIGGER_CRITERIA=MULTI_BUS_VERIFIED

# ==============================================================================
# 4. COMPUTER VISION & EDGE AI (YOLOv8)
# ==============================================================================
YOLO_MODEL_PATH=ml/models/yolov8_road_v1.pt
YOLO_CONF_THRESHOLD=0.50
YOLO_IOU_THRESHOLD=0.45
