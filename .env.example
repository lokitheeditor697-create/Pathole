# ==============================================================================
# Smart City Road-Defect & Transit Verification System — Environment Config
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Optional: Set this if frontend is hosted on a separate domain/port (e.g. Vercel)
# Default in local dev: http://127.0.0.1:8000
# Default in Docker/Production: "" (relative path on same origin)
VITE_API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT ALERTS (Free & Instant Official Alerts)
# ------------------------------------------------------------------------------
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Get your Chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=987654321

# ------------------------------------------------------------------------------
# 3. GMAIL / SMTP EMAIL TICKETS (Formal Dispatch Emails)
# ------------------------------------------------------------------------------
# Sender Gmail address
GMAIL_USER=pwd.chennaicorp@gmail.com

# 16-character Google App Password (from Google Account -> Security -> App Passwords)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Comma-separated list of municipal official recipient email addresses
ALERT_RECIPIENTS=roadmaintenance@chennaicorp.gov.in,wardofficer@chennai.gov.in

# ------------------------------------------------------------------------------
# 4. SERVER & DEPLOYMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Host and Port (used in Docker / Cloud Providers like Render or Hugging Face)
HOST=0.0.0.0
PORT=8000
